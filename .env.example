# Copie para .env e ajuste se necessario. Nenhuma variavel e obrigatoria.

# Raiz do data lake. Local (padrao):
LAKE_ROOT=lake
# AWS S3 (requer pip install -r requirements/requirements.s3.txt):
# LAKE_ROOT=s3://meu-bucket/cvm-lake

# Opcoes extras do fsspec em JSON (ex.: perfil do ~/.aws/credentials)
# LAKE_STORAGE_OPTIONS={"profile": "datalake"}

# Timeouts (segundos) dos downloads da CVM
HTTP_CONNECT_TIMEOUT=15
HTTP_READ_TIMEOUT=300

# Logs
LOG_LEVEL=INFO
# LOG_DIR=logs

# Relatorio de insights
REPORT_OUTPUT_PATH=docs/INSIGHTS.md
